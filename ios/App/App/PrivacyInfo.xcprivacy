<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Apple required-reason API declaration (Stage M3a).

	  @capacitor/filesystem reads file creation and modification timestamps
	  (ios/Sources/FilesystemPlugin/IONFileStructures+Converters.swift), which is
	  a required-reason API. The plugin ships no manifest of its own and its
	  README directs the host app to declare it here.

	  C617.1 — "Accessing the timestamp of files inside the app container" — is
	  the reason that matches what this app actually does: it writes an export
	  into its OWN cache container and hands it to the share sheet. It never
	  reads timestamps of files outside the container.

	  Optional PostHog analytics additionally declares product interactions and
	  pseudonymous user identifiers for Analytics, linked but not advertising
	  tracking. Collection requires explicit configuration and separate consent.
	  No tracking domains or broad file-access permission are added.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAnalytics</string></array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array><string>NSPrivacyCollectedDataTypePurposeAnalytics</string></array>
		</dict>
	</array>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
</dict>
</plist>
