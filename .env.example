# Optional Supabase Auth configuration (see docs/CLOUD_IDENTITY_AND_COLLABORATION_ARCHITECTURE.md
# and src/lib/supabase/config.ts). Both are PUBLIC, browser-exposed values.
#
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY must be a current Supabase publishable
# key (starts with "sb_publishable_" - see
# https://supabase.com/docs/guides/getting-started/api-keys). Never put a
# secret key (starts with "sb_secret_") or any other service-role credential
# in a `NEXT_PUBLIC_*` variable - it would be exposed to every browser.
#
# Leave both unset (or copy this file to .env.local and leave them blank) to
# run fully cloud-disabled - the app works exactly the same either way; the
# only difference is whether the optional account/sign-in control appears.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# External setup this repository's code cannot do for you: the hosted
# Supabase Auth "Magic Link" / "OTP" email template must contain
# `{{ .Token }}` for the six-digit-code UI in this app to work - if the
# template instead contains `{{ .ConfirmationURL }}`, Supabase sends a magic
# link, not a code. Custom SMTP must also be configured before testing with
# real users outside the Supabase project team (the built-in email service is
# rate-limited to project members). See
# https://supabase.com/docs/reference/javascript/auth-signinwithotp
