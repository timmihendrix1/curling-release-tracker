# Optional Supabase Auth configuration (see docs/CLOUD_IDENTITY_AND_COLLABORATION_ARCHITECTURE.md
# and src/lib/supabase/config.ts). Both are PUBLIC, browser-exposed values.
#
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY must be a current Supabase publishable
# key (starts with "sb_publishable_" - see
# https://supabase.com/docs/guides/getting-started/api-keys). Never put a
# secret key (starts with "sb_secret_") or any other service-role credential
# in a `NEXT_PUBLIC_*` variable - it would be exposed to every browser.
#
# Leave both unset (or copy this file to .env.local and leave them blank) to
# run fully cloud-disabled - the app works exactly the same either way; the
# only difference is whether the optional account/sign-in control appears.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# External setup this repository's code cannot do for you: the hosted
# Supabase Auth "Magic Link" / "OTP" email template must contain
# `{{ .Token }}` for the six-digit-code UI in this app to work - if the
# template instead contains `{{ .ConfirmationURL }}`, Supabase sends a magic
# link, not a code. Custom SMTP must also be configured before testing with
# real users outside the Supabase project team (the built-in email service is
# rate-limited to project members). See
# https://supabase.com/docs/reference/javascript/auth-signinwithotp

# Team Foundation outbound email (see src/lib/email/smtpEmailService.ts and
# docs/adr/0022-team-foundation-domain-and-persistence.md). SERVER-ONLY - none of
# these are `NEXT_PUBLIC_*` and none may ever be read from browser-reachable code.
# Provider-neutral plain SMTP: any provider that exposes an SMTP relay works here
# without a code change. Leave all blank to run without team-invitation/admin-request/
# removal-notice email delivery - the Team Foundation domain logic still works, but
# every send attempt reports an honest delivery failure rather than a fabricated
# "sent" result.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

# The ONE canonical origin the four Team Foundation email links that carry an
# accept link are built from - invitation create/revise/resend (which embed the
# raw one-time invitation token) and Admin Request creation (which embeds only the
# request's non-secret id, never a secret). See
# src/app/api/team/_lib/context.ts's `resolveAppOriginConfig`/`buildAcceptUrl` and
# docs/adr/0022-team-foundation-domain-and-persistence.md's "§Canonical Email Link
# Origin". SERVER-ONLY - deliberately NOT `NEXT_PUBLIC_*`; never derived from an
# incoming request's Host/forwarded-host header, which is attacker- or
# proxy-influenced input and must never determine where a link carrying that token
# or id points.
#
# Must be a bare origin - scheme://host[:port], nothing else (no path, query,
# fragment, or credentials). Production deployments MUST use https. http is only
# accepted for localhost/127.0.0.1/::1, for local development and tests. Leave
# blank to disable email delivery for just these four routes - each one's
# underlying Team Foundation mutation still completes, and the route reports an
# honest `emailSent: false` rather than fabricating success or falling back to any
# request-derived origin. The fifth Team Foundation email (member removal, whose
# `notificationEmailSent` result carries no accept link at all) does not read this
# variable and is unaffected by it either way.
#
# Examples: "https://app.example.com" (production) or "http://localhost:3000"
# (local development).
APP_ORIGIN=
